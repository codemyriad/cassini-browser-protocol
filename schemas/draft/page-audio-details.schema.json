{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "D73 approved paired-field amendment, portable captureRecord v1 overlay",
  "$comment": "Additional paired metadata validation for recordingDetails.captureRecord version1. Preserve unknown newer records without downgrading. Not a complete portable format schema. D73.12: persisted pair is open raw strings, at most200 Unicode code points; no normalization. Wire enums remain separate.",
  "type": "object",
  "properties": {
    "recordingDetails": {
      "type": "object",
      "properties": {
        "captureRecord": {
          "type": "object",
          "properties": {
            "version": {
              "const": 1
            },
            "tracks": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/pageAudioMetadata"
              }
            },
            "sources": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/pageAudioMetadata"
              }
            }
          },
          "required": [
            "version"
          ]
        }
      }
    }
  },
  "$defs": {
    "pageAudioMetadata": {
      "type": "object",
      "properties": {
        "sourceClass": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 200
        },
        "localAudio": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 200
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "sourceClass"
            ],
            "properties": {
              "sourceClass": {
                "type": "string"
              }
            }
          },
          "then": {
            "required": [
              "localAudio"
            ],
            "properties": {
              "localAudio": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "localAudio"
            ],
            "properties": {
              "localAudio": {
                "type": "string"
              }
            }
          },
          "then": {
            "required": [
              "sourceClass"
            ],
            "properties": {
              "sourceClass": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "sourceClass"
            ],
            "properties": {
              "sourceClass": {
                "const": "page-audio-mix"
              }
            }
          },
          "then": {
            "required": [
              "kind",
              "sourceTrackId"
            ],
            "properties": {
              "kind": {
                "const": "media"
              },
              "sourceTrackId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            }
          }
        }
      ]
    }
  }
}
