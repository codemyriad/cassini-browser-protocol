{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Selection for an isolated trusted test controller only; not a production message or authority flag.",
  "type": "object",
  "properties": {
    "sourceClass": {
      "const": "page-audio-mix"
    },
    "scope": {
      "const": "page-media-test"
    },
    "sourceTrackIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    }
  },
  "required": [
    "sourceClass",
    "scope",
    "sourceTrackIds"
  ],
  "additionalProperties": false
}
