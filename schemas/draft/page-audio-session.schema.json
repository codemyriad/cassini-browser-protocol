{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "D73.11 approved paired-field amendment; session overlay",
  "$comment": "Approved additive format metadata, not a complete validator; validate together with canonical session.schema.json. Host/app implementation and release remain separate. D73.12: persisted pair is open raw strings, at most200 Unicode code points; no normalization. Wire enums remain separate.",
  "type": "object",
  "properties": {
    "tracks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/pageAudioMetadata"
      }
    },
    "captureOutcome": {
      "type": "object",
      "properties": {
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pageAudioMetadata"
          }
        }
      }
    }
  },
  "$defs": {
    "pageAudioMetadata": {
      "type": "object",
      "properties": {
        "sourceClass": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 200
        },
        "localAudio": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 200
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "sourceClass"
            ],
            "properties": {
              "sourceClass": {
                "type": "string"
              }
            }
          },
          "then": {
            "required": [
              "localAudio"
            ],
            "properties": {
              "localAudio": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "localAudio"
            ],
            "properties": {
              "localAudio": {
                "type": "string"
              }
            }
          },
          "then": {
            "required": [
              "sourceClass"
            ],
            "properties": {
              "sourceClass": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "sourceClass"
            ],
            "properties": {
              "sourceClass": {
                "const": "page-audio-mix"
              }
            }
          },
          "then": {
            "required": [
              "kind",
              "sourceTrackId"
            ],
            "properties": {
              "kind": {
                "const": "media"
              },
              "sourceTrackId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            }
          }
        }
      ]
    }
  }
}
