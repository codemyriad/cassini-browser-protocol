{
  "status": "literal contract expectations, not a live implementation oracle",
  "composition": {
    "inclusion": "composition-epochs.session.json",
    "exclusion": "composition-exclusion-refused.session.json",
    "boundaryMs": 1000,
    "expect": {
      "freshSourceTrackIdPerEpoch": true,
      "preservePriorMetadata": true,
      "noNewExcludedSamplesAfterBoundary": true
    }
  },
  "nativePreflight": [
    {
      "name": "old-writer-mic-true",
      "microphone": true,
      "sequence": [
        {
          "send": {
            "type": "negotiate",
            "features": [
              "page-audio-mix-v1",
              "source-outcomes-v1"
            ]
          }
        },
        {
          "delay": "state-held acknowledgement, not a sleep"
        },
        {
          "reply": {
            "type": "error",
            "code": "version",
            "message": "Unsupported request."
          }
        },
        {
          "close": true
        }
      ],
      "expect": {
        "startSent": false,
        "nativeInputOpened": false,
        "nativeAudio": false,
        "visibleRecording": false,
        "folderCreated": false,
        "cleanup": "close-probe-connection",
        "ok": false,
        "code": "unsupported"
      }
    },
    {
      "name": "supported-writer-delayed-ack",
      "microphone": true,
      "sequence": [
        {
          "send": {
            "type": "negotiate",
            "features": [
              "page-audio-mix-v1",
              "source-outcomes-v1"
            ]
          }
        },
        {
          "delay": "state-held acknowledgement, not a sleep"
        },
        {
          "assertBeforeAck": {
            "nativeInputOpened": false,
            "visibleRecording": false,
            "folderCreated": false
          }
        },
        {
          "reply": {
            "type": "negotiated",
            "features": [
              "page-audio-mix-v1",
              "source-outcomes-v1"
            ]
          }
        },
        {
          "send": {
            "type": "start",
            "microphone": true,
            "features": [
              "page-audio-mix-v1",
              "source-outcomes-v1"
            ]
          }
        }
      ],
      "expect": {
        "sameConnection": true,
        "explicitMicAuthorization": true,
        "onlyAfterNegotiation": true
      }
    }
  ],
  "selectionLifecycle": [
    {
